# Root directory containing raw source corpora and intermediate generation data.
FACTGUARD_DATA_DIR=/absolute/path/to/factguard_generation_data

# OpenAI-compatible chat completion endpoint used by the generation scripts.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_URL=http://127.0.0.1:8000/v1/chat/completions
VLLM_API_KEY=EMPTY
EMBEDDING_BASE_URL=http://127.0.0.1:8081
EMBEDDING_API_KEY=
FACTGUARD_DEBUG=false
